{
  "appId": "dev.agentviewer.desktop",
  "productName": "AgentViewer",
  "asar": false,
  "directories": { "output": "release" },
  "files": [
    "dist/main/**",
    "dist/renderer/**",
    "dist/mcp/**",
    "assets/agentviewer.ico",
    "docs/licenses/**",
    "package.json"
  ],
  "extraResources": [
    { "from": "dist/engines", "to": "engines" },
    { "from": "plugins/agent-viewer", "to": "plugin/agent-viewer" }
  ],
  "win": { "icon": "assets/agentviewer.ico", "signAndEditExecutable": false }
}
