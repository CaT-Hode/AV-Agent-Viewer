{
  "name": "agent-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:web": "tsx apps/local-service/src/dev.ts",
    "build": "tsc --noEmit && node scripts/build.mjs && vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/core.test.ts",
    "test:desktop": "tsx tests/desktop.e2e.ts",
    "test:startup": "tsx tests/startup.e2e.ts",
    "test:home-search": "tsx --test tests/home-search.test.ts tests/home-tabs.test.ts tests/background-open.test.ts && tsx tests/home-search.e2e.ts",
    "test:office": "tsx --test tests/office-editing.test.ts tests/office-drafts.test.ts tests/native-office-runtime.test.ts tests/native-office-worker.test.ts tests/native-office-writer.test.ts tests/native-office-tools.test.ts tests/office-toolbox.test.ts && tsx tests/native-office.e2e.ts",
    "test:office:semantic": "tsx tests/native-office-semantic.e2e.ts",
    "test:reader-interaction": "tsx tests/reader-interaction.e2e.ts",
    "test:rendering-performance": "tsx tests/rendering-performance.e2e.ts",
    "test:ui": "tsx tests/ui-smoke.e2e.ts",
    "test:motion": "tsx tests/ui-motion.e2e.ts",
    "test:glass": "tsx --test tests/glass-elasticity.test.ts && tsx tests/ui-glass-components.e2e.ts && tsx tests/native-backdrop.e2e.ts",
    "test:navigation": "tsx --test tests/navigation-visibility.test.ts tests/navigation-optics.test.ts tests/glass-pixel-helpers.test.ts tests/glass-optics-cache.test.ts && tsx tests/ui-navigation.e2e.ts && tsx tests/ui-glass-optics.e2e.ts && tsx tests/ui-glass-content.e2e.ts",
    "test:engines": "tsx tests/engines.e2e.ts",
    "test:portable": "tsx tests/portable.e2e.ts",
    "engines:verify": "node scripts/verify-engines.mjs",
    "engines:prepare": "node scripts/prepare-engines.mjs",
    "engines:stage": "node scripts/stage-engines.mjs",
    "engines:bootstrap": "tsx scripts/generate-office-bootstrap-seed.ts",
    "package:portable": "npm run build && npm run engines:prepare && npm run engines:stage && npm run engines:bootstrap && electron-builder --win --x64 --dir --publish never",
    "install:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-local.ps1",
    "mcp": "tsx apps/local-service/src/mcp.ts",
    "cli": "tsx packages/sdk/src/cli.ts"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.43.14",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@xmldom/xmldom": "*",
    "codemirror": "^6.0.2",
    "dompurify": "^3.2.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "lucide-react": "*",
    "parse5": "^8.0.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tesseract.js": "^7.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "*",
    "electron": "44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "*",
    "playwright": "*",
    "pptxgenjs": "*",
    "tsx": "*",
    "typescript": "^5.9.3",
    "vite": "8.3.4"
  }
}
