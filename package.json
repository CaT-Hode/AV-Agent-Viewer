{
  "name": "agent-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:web": "tsx apps/local-service/src/dev.ts",
    "build": "node scripts/check-docs.mjs && tsc --noEmit && node scripts/build.mjs && vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "docs:check": "node scripts/check-docs.mjs",
    "dependencies:report": "node scripts/dependency-report.mjs",
    "test": "node scripts/test.mjs",
    "test:desktop": "node scripts/test.mjs desktop",
    "test:office": "node scripts/test.mjs office",
    "engines:verify": "node scripts/verify-engines.mjs",
    "engines:prepare": "node scripts/prepare-engines.mjs",
    "engines:stage": "node scripts/stage-engines.mjs",
    "engines:bootstrap": "tsx scripts/generate-office-bootstrap-seed.ts",
    "package:portable": "npm run build && npm run engines:prepare && npm run engines:stage && npm run engines:bootstrap && electron-builder --win --x64 --dir --publish never",
    "install:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-local.ps1",
    "mcp": "tsx apps/local-service/src/mcp.ts",
    "cli": "tsx packages/sdk/src/cli.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.43.14",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@rokt33r/js-sequence-diagrams": "^2.0.6-2",
    "@xmldom/xmldom": "*",
    "codemirror": "^6.0.2",
    "dompurify": "^3.2.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "flowchart.js": "^1.18.0",
    "gemoji": "^8.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "*",
    "mathjax-full": "^3.2.2",
    "mermaid": "^12.2.0",
    "parse5": "^8.0.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "raphael": "^2.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tesseract.js": "^7.0.0",
    "underscore": "^1.13.7",
    "zod": "^3.25.76"
  },
  "overrides": {
    "@rokt33r/js-sequence-diagrams": {
      "raphael": "$raphael",
      "underscore": "$underscore"
    },
    "katex": "^0.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "*",
    "electron": "44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "*",
    "playwright": "*",
    "pptxgenjs": "*",
    "tsx": "*",
    "typescript": "^5.9.3",
    "vite": "8.3.4"
  }
}
